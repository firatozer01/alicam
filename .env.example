WEB_PORT=3000
API_PORT=8091
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1

APP_ENV=production
APP_DEBUG=false
APP_URL=https://alicam.net
APP_KEY=
APP_TIMEZONE=Europe/Istanbul
SESSION_COOKIE_NAME=alicamnet-session
SESSION_DOMAIN=alicam.net
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=alicam.net,www.alicam.net
FRONTEND_URL=https://alicam.net
# Yalnızca yerel geliştirmede true; üretimde daima false.
VERIFICATION_EXPOSE_CODES=false

# PayTR Mağaza Paneli > Destek & Kurulum Bilgileri bölümünden alınır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true
PAYTR_DEBUG_ON=true
PAYTR_TIMEOUT_LIMIT=30
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0

POSTGRES_DB=alicam
POSTGRES_USER=alicam
POSTGRES_PASSWORD=change-this-in-production

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=bildirim@alicam.net
MAIL_FROM_NAME=alıcam.net

# WebSocket (Laravel Reverb) — anlık mesajlaşma.
# Anahtar üretmek için:  openssl rand -hex 16   ve   openssl rand -hex 24
# APP_KEY tarayıcıya açıktır (Pusher protokolünde böyledir); gizli olan SECRET'tır.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=alicam
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Tarayıcının bağlanacağı GENEL adres. ÜRETİMDE MUTLAKA DEĞİŞTİR:
#   REVERB_PUBLIC_HOST=alicam.net
#   REVERB_PUBLIC_PORT=443
#   REVERB_PUBLIC_SCHEME=https
# Yanlış bırakılırsa hata çıkmaz; her tarayıcı sessizce yoklamaya düşer.
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8092
REVERB_PUBLIC_SCHEME=http

# Konteyner dışına açılan port. Kullanılan 3000/8091'e dokunulmaz.
# Üretimde ön nginx bunu wss olarak 443'e taşır:
#   location /app/   { proxy_pass http://127.0.0.1:8092; ... Upgrade başlıkları }
#   location /apps/  { proxy_pass http://127.0.0.1:8092; }
REVERB_BIND_ADDRESS=127.0.0.1
