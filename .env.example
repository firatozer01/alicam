WEB_PORT=3000
API_PORT=8091

APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=Europe/Istanbul
SESSION_COOKIE_NAME=alicamnet-session
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# Yalnızca yerel geliştirmede true; üretimde daima false.
VERIFICATION_EXPOSE_CODES=false

# PayTR Mağaza Paneli > Destek & Kurulum Bilgileri bölümünden alınır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true
PAYTR_DEBUG_ON=true
PAYTR_TIMEOUT_LIMIT=30
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0

POSTGRES_DB=alicam
POSTGRES_USER=alicam
POSTGRES_PASSWORD=change-this-in-production
